    for(size_t i = 0; i < v.size(); i++) os << v[i] << (i+1 < v.size() ? " " : "");
    return os << '\n';
}

template<class T> vector<T> vin(int n) {
    vector<T> v(n);
    for (auto& x : v) cin >> x;
    return v;
}
// auto a = vin<int>(n);
// auto s = vin<string>(n);

template<class T> vector<vector<T>> vin2(int h, int w) {
    vector<vector<T>> v(h, vector<T>(w));
    for (auto& row : v) for (auto& x : row) cin >> x;
    return v;
}

